  "keyFeatures": [
    "Three-command CLI for record, deploy, and diagnostics",
    "Unified robot interface with observe(), act(), reset()",
    "Self-describing models with HuggingFace Hub integration",
    "Rust core for real-time control with Python SDK",
    "Support for SO-101 arm, Unitree Go2 quadruped, and custom robots",
    "Multiple simulation backends (Genesis, MuJoCo MJX, Mock)",
    "JIT compiler for high-performance kernel execution",
    "LeRobot dataset integration for data collection"
  ],
